# Configuration for kerio-control-integration-with-wazuh-siem
# Copy to config.env and set permissions:
#   cp config.env.example config.env
#   sudo chown root:root config.env && sudo chmod 600 config.env

# IP address or CIDR network of the Kerio Control UTM appliance (RFC 5737 example)
# Can be a single host (e.g. 192.0.2.1) or a subnet/CIDR (e.g. 192.0.2.0/24 or 0.0.0.0/0)
KERIO_IP=192.0.2.1

# IP address of this Wazuh manager to bind the syslog listener to (or 0.0.0.0 for all interfaces)
LISTEN_IP=192.0.2.10

# Port and transport protocol for Kerio Control syslog (default: 514 UDP)
SYSLOG_PORT=514
SYSLOG_PROTOCOL=udp

# Wazuh directory and systemd service
OSSEC_DIR=/var/ossec
SERVICE_NAME=wazuh-manager

# Backup directory and retention (number of backups to keep)
BACKUP_ROOT=/root/kerio-control-integration-with-wazuh-siem-backups
BACKUP_KEEP=10

# Rule ID allocation range
RULE_ID_MIN=100800
RULE_ID_MAX=100899

# Extended regex of known unrelated errors in ossec.log to ignore during verification
LOG_IGNORE_REGEX=""

# Seconds to wait for connected agents to recover after wazuh-manager restart
AGENT_RECOVERY_TIMEOUT=180
